# Plantilla opcional para Docker Compose. Copia a .env y rellena los tres valores.
# También puedes definirlos en la terminal o en tu gestor de contenedores.

# Token del bot proporcionado por @BotFather.
TELEGRAM_BOT_TOKEN=TOKEN_DEL_BOT

# Uno o varios ID de usuarios autorizados, positivos y separados por comas.
TELEGRAM_OWNER_ID=ID_USUARIO_TELEGRAM

# ID numérico negativo del grupo, supergrupo o canal de destino.
TELEGRAM_CHANNEL_ID=ID_GRUPO_CANAL_TELEGRAM
